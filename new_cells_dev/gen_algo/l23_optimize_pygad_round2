def fitness_function(ga_instance, solution, solution_idx):

    # neuron imports
    import neuron
    from neuron import h
    from neuron.units import ms, mV

    soma_dend_atten, l2_allen, l3_allen = _get_targets()
    l2_allen.ap_width *= 1000
    l3_allen.ap_width *= 1000

    ephys = dict()
    measures = ['RMP', 'upstroke_downstroke', 'ap_width', 'ap_threshold', 'tau', 'sag', 'mean_isi', 'first_isi',  'FR_slope']

    # bring params in the right format
    params_dict = reconstruct_params(solution)  

    # RMP
    print("RMP...", flush=True)
    ephys['RMP'], grad, soma_voltg, t = rmp_grad(params_dict)

    # AP measures
    print("AP...", flush=True)
    ap_thresh, ap_width, ap_up_down = ap_measures(params_dict)
    ephys['ap_width'], ephys['ap_threshold'], ephys['upstroke_downstroke'] = ap_width, ap_thresh, ap_up_down

    # Membrane time constant
    print("Membrane time constant...", flush=True)
    tau = membrane_time_constant(params_dict)
    ephys['tau'] = tau

    # Attenuation
    print('Attenuation...', flush=True)
    lambda_spike_amp, lambda_upstroke, lambda_hyperpol_amp = get_all_attenuation(params_dict)
    # get losses
    l_bAp = np.abs(soma_dend_atten['bAp'] - lambda_spike_amp)
    l_upstroke = np.abs(soma_dend_atten['bAp_upstroke'] - lambda_upstroke)
    l_hyperpol = np.abs(soma_dend_atten['hyperpol'] - lambda_hyperpol_amp)
    l_matrix = np.array([l_bAp, l_upstroke, l_hyperpol])
    loss_weight = np.array([1, 1, .001])          # hyerpolarization messes with tau so reduce importance
    
    # all fitness

    fitness = np.zeros((6,))

    for i,m in enumerate(measures[:5]):
        target = np.concatenate((l2_allen[m].dropna().values,l3_allen[m].dropna().values))

        # current loss

        # if within range, select small loss
        if ephys[m] >= np.min(target) and ephys[m] < np.max(target):
            fitness[i] = 1/0.001
        # else, calculate difference to median
        else:
            fitness[i] = 1/(np.abs(ephys[m]-np.median(target))+0.001)

    fitness[-1] = 1/(l_matrix@loss_weight)             # attenuation loss
    
    #print("RMP done. Testing AP...", flush=True)
    # # AP measures
    # ap_thresh, ap_peak, v_soma, t = ap_measures(keys, conductances)

    # ap_thresh_fit = 1/(np.abs(ap_thresh-ephys_measures['ap_thresh'])+0.01)
    # ap_peak_fit = 1/(np.abs(ap_peak-ephys_measures['ap_peak'])+0.01)

    # fitness[1] = np.mean(np.array((ap_thresh_fit, ap_peak_fit)))

    # print("AP done. Testing FI...", flush=True)
    # # FI slope
    # fi_slo = fi_slope(keys, conductances)

    # fitness[2] = 1/(np.abs(fi_slo-ephys_measures['fi_slope'])+0.01)

    # # Rebound

    # rebound_model, sag_ratio_model, inp_res_max = rebound(sections, cell_tree, keys, conductances)

    # inp_res = 1/(abs(inp_res_max-ephys_measures['ss_inp_res'])+0.01)
    
    # reb = 1/(np.abs(rebound_model-ephys_measures['rebound'])+0.01)

    # sagr = 1/(np.abs(sag_ratio_model-ephys_measures['sag_ratio'])+0.01)

    # fitness[3] = (inp_res + reb + sagr)/3

    return np.mean(fitness)


