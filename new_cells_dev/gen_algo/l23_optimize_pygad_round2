def main():
    
    num_gen = 500
    population_size = 600
    num_parents_mating = int(population_size*0.15)    

    gene_space = [[0.05, 3],
                [0.05, 2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2], 
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2], 
                [0.0, 1e-2],
                [0.0, 1e-2],
                [0.0, 1e-2],
                [60, 400], 
                [0.0, 1e-2],
                [-90, -50],
                [0.5, 3],
                [70, 200]]

    initial_params = _get_start_params()
    initial_solution = flatten_params(initial_params)
    initial_solution = np.array(initial_solution).reshape(1, -1)

    # generate start values
    initial_population = np.empty((population_size-1, len(gene_space)))
    for i, gene in enumerate(gene_space):
        initial_population[:,i] = np.random.uniform(gene[0], gene[1], population_size-1)

    initial_population = np.concatenate((initial_solution, initial_population), axis=0)

    print(f'initial pop size {initial_population.shape}', flush=True)

    global fitness_list
    global parents_list

    fitness_list = []
    parents_list = []

    
    ga_instance = pygad.GA(num_generations=num_gen,
                    num_parents_mating=num_parents_mating,
                    sol_per_pop = population_size,
                    # # here are several attempts to avoid early convergence
                    #K_tournament=4,  # Larger tournament size reduces selection pressure
                    # allow_duplicate_genes=False,  # Prevent duplicate solutions
                    # crossover_type="uniform",
                    keep_parents = 10,
                    #parent_selection_type='tournament',
                    fitness_func=fitness_function,
                    num_genes=len(gene_space),
                    initial_population=initial_population,
                    mutation_type="adaptive",
                    mutation_probability=[0.6, 0.2],
                    mutation_by_replacement=True,
                    gene_space=gene_space,
                    on_fitness=on_fitness,
                    on_parents=on_parents,
                    on_crossover=on_crossover,
                    on_mutation=on_mutation,
                    on_generation=on_generation,
                    on_stop=on_stop,
                
                    parallel_processing=["process", 60])

    ga_instance.run()

    ga_instance.save(f'{pth_rslts}/pygad_inst')

if __name__ == "__main__":
    main()