def _get_target_measures():
    # Combine L2 and L3 data for target ranges
    target_median = {}
    measures = ['RMP', 'sag', 'mean_isi', 'first_isi', 'upstroke_downstroke', 'ap_width', 'ap_threshold', 'FR_slope', 'tau']

    for measure in measures:
        data = np.concatenate((l2_allen[measure].dropna().values,l3_allen[measure].dropna().values))
        target_median[measure] = np.median(data)

    target_median['lambda_atten'] = 290  # Gidon et al., 2020
    target_median['lambda_upstroke'] = 121  # according to Gidon et al., 2020

    # get the hand-tuned ca spike
    import pickle
    with open(os.path.join('/Users/katharinaduecker/Documents/projects_brown/hnn_dev/figures/newl3_iascone/', 'l23_ca_spike.pkl'), 'rb') as f:
        ca_properties = pickle.load(f)

    for key in ca_properties.keys():
        target_median[key] = ca_properties[key]
    
    return target_median


def _fit_len_const(x, lambda_val, A):
    return A * np.exp(-x / lambda_val)

def _fit_taum(t, tau, A, C):
    return A * (1 - np.exp(-t / tau)) + C



