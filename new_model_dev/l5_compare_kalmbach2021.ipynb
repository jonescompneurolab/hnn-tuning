    "# l5 dataframe\n",
    "l5df = df[df['etype'] == 1]\n",
    "\n",
    "# Measures of interest:\n",
    "# resting potential\n",
    "# Sag_ratio\n",
    "# Rebound slope\n",
    "# Resonant frequency (chirp stimulus)\n",
    "# AP threshold\n",
    "# AP peak\n",
    "# FI_slope\n",
    "# Inout resistance SSRn\n",
    "\n",
    "fig, ax = plt.subplots(2, 4, figsize=(16,6))\n",
    "\n",
    "ax = ax.ravel()\n",
    "ax[0].boxplot(l5df['RMP'], vert=True, patch_artist=True, labels=['RMP'])\n",
    "ax[0].set_ylabel('resting potential (mV)')\n",
    "\n",
    "ax[1].boxplot(l5df['Sag_ratio'], vert=True, patch_artist=True, labels=['sag_ratio'])\n",
    "ax[1].set_ylabel('sag ratio')\n",
    "\n",
    "ax[2].boxplot(l5df['Rebound'], vert=True, patch_artist=True, labels=['rebound'])\n",
    "ax[2].set_ylabel('rebound slope')\n",
    "\n",
    "ax[3].boxplot(l5df['Fr'], vert=True, patch_artist=True, labels=['resonant freq'])\n",
    "ax[3].set_ylabel('resonant freq')\n",
    "\n",
    "ax[4].boxplot(l5df['AP_threshold'], vert=True, patch_artist=True, labels=['AP threshold'])\n",
    "ax[4].set_ylabel('AP threshold (mV)')\n",
    "\n",
    "ax[5].boxplot(l5df['AP_peak'], vert=True, patch_artist=True, labels=['AP peak'])\n",
    "ax[5].set_ylabel('AP peak (mV)')\n",
    "\n",
    "ax[6].boxplot(l5df['FI_slope_max'], vert=True, patch_artist=True, labels=['FI slope max'])\n",
    "ax[6].set_ylabel('max gain(spikes/pA)')\n",
    "\n",
    "ax[7].boxplot(l5df['SSRn'], vert=True, patch_artist=True, labels=['SS input resistance'])\n",
    "ax[7].set_ylabel('input resistance MOhms')\n",
    "\n",
    "\n",
    "fig.tight_layout()"
   ]
