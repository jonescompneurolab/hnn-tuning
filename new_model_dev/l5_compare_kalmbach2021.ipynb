    "ampl = np.linspace(-0.1, -2, 100)\n",
    "\n",
    "\n",
    "soma_v = np.zeros((len(ampl),int(1/h.dt*205+1)))\n",
    "peak_heights = np.zeros_like(ampl)\n",
    "steady_state = np.zeros_like(ampl)\n",
    "min_membr_pot = np.zeros_like(ampl)\n",
    "sag_ratio = np.zeros_like(ampl)\n",
