    "# Chirp stimulus\n",
    "\n",
    "\n",
    "from scipy.signal import chirp\n",
    "l5pyr= Cell(sections, cell_tree, cell_type='L5_pyramidal', gid=0)\n",
    "\n",
    "l5pyr.build()\n",
    "l5pyr = mech_class.add_mechs(l5pyr, hay_model_params, hotzone=hotzone)\n",
    "\n",
    "# Define simulation parameters\n",
    "h.tstop = 20_100  # Simulation duration in ms\n",
    "h.dt = 0.1    # Time step\n",
    "\n",
    "# Create a chirp stimulus (linear frequency sweep)\n",
    "t_chirp = np.arange(0, h.tstop, h.dt)  # Time vector\n",
    "\n",
    "# Kalmbach et al: linear increase from 1-15 Hz over\n",
    "f0 = 0.2  # Initial frequency in Hz\n",
    "f1 = 40  # Final frequency in Hz\n",
    "A = .1  # Amplitude of the chirp in nA - adjusted to achieve a voltage deflection of ~10mV peak to peak \n",
    "\n",
    "# Chirp signal: I(t) = A * sin(2 * pi * f(t) * t)\n",
    "#f_t = f0 + (f1 - f0) * t_chirp / h.tstop  # Linearly increasing frequency\n",
    "#chirp_signal = A * np.sin(2 * np.pi * f_t * t_chirp/1000)  + .2# Convert ms to seconds\n",
    "\n",
    "# logarithmic chirp\n",
    "chirp_signal = A * chirp(t_chirp/1000, f0, 20, f1, method='log') + 0.1\n",
    "\n",
    "# set up clamp\n",
    "stim = h.IClamp(l5pyr._nrn_sections['soma'](0.5))\n",
    "stim.delay = 0\n",
    "stim.dur = h.tstop+stim.delay\n",
    "stim.amp = 0  # We'll use Vector.play() to set the amplitude\n",
    "# Apply the chirp stimulus using a Vector and play()\n",
    "stim_vec = h.Vector(chirp_signal)\n",
    "t = np.arange(0, h.tstop, h.dt)\n",
    "time_vec = h.Vector(t)\n",
    "stim_vec.play(stim._ref_amp, time_vec, 1)\n",
    "\n",
    "# Record membrane potential\n",
    "v_rec = h.Vector()\n",
    "v_rec.record(l5pyr._nrn_sections['soma'](0.5)._ref_v)\n",
    "t_rec = h.Vector().record(h._ref_t)\n",
    "# Run the simulation\n",
    "h.finitialize()  # Initialize membrane potential\n",
    "h.continuerun(h.tstop)\n",
    "\n",
    "# Plot results\n",
    "\n",
    "fig, ax = plt.subplots(2,1, figsize=(12,6))\n",
    "\n",
    "ax[0].plot(t, chirp_signal)\n",
    "ax[0].set_ylabel('current (nA)')\n",
    "ax[0].set_title('chirp stimulus')\n",
    "\n",
    "ax[1].plot(t_rec-stim.delay, v_rec.as_numpy(), label='Membrane Potential')\n",
    "ax[1].set_xlabel('time (ms)')\n",
    "ax[1].set_ylabel('voltage (mV)')\n",
    "ax[1].set_title('membrane potential')\n",
    "fig.tight_layout()\n",
    "\n",
    "#fig.savefig(os.path.join(figpth, 'chirp_stim.png'))\n"
   ]
