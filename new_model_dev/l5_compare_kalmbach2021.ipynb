    "# Kalmbach: impedance amplitude is the ratio between FFT of response and FFT of chirp\n",
    "\n",
    "from scipy.fft import fft, fftfreq\n",
    "\n",
    "from scipy.signal import windows\n",
    "gauss_win = windows.gaussian(len(chirp_signal), len(chirp_signal)/1.5)\n",
    "\n",
    "N = len(v_rec)\n",
    "T = h.dt/1000\n",
    "freq = fftfreq(N, T)[:N//2]\n",
    "lowf = np.argmin(np.abs(freq-0.2))\n",
    "\n",
    "fft_membr = fft(v_rec.as_numpy()[1:])\n",
    "fft_chirp = fft(chirp_signal)\n",
    "\n",
    "impedance = fft_membr/fft_chirp\n",
    "zap = np.abs(impedance)\n",
    "zap = zap[:N//2]\n",
    "\n",
    "fig, ax = plt.subplots(3,2,figsize=(12,8))\n",
    "fft_membr =  2.0/N * np.abs(fft_membr[:N//2])\n",
    "ax[0,0].plot(freq[lowf:], fft_membr[lowf:])\n",
    "# ax[0,0].set_xlim([1, 40])\n",
    "ax[0,0].set_ylim([0, .4])\n",
    "ax[0,0].grid()\n",
    "ax[0,0].set_title('FFT membrane potential')\n",
    "\n",
    "fft_chirp = 2.0/N * np.abs(fft_chirp[:N//2])\n",
    "ax[1,0].plot(freq[lowf:], fft_chirp[lowf:])\n",
    "ax[1,0].set_title('FFT chirp')\n",
    "# ax[1,0].set_xlim([1, 40])\n",
    "ax[1,0].set_ylim([0, .02])\n",
    "\n",
    "ax[1,0].grid()\n",
    "\n",
    "ax[2,0].plot(freq[lowf:], zap[lowf:])\n",
    "ax[2,0].set_xlabel('frequency (Hz)')\n",
    "ax[2,0].set_title('ZAP')\n",
    "# ax[2,0].set_xlim([0, 40])\n",
    "# ax[2,0].set_ylim([0, 40])\n",
    "\n",
    "ax[2,0].grid()\n",
    "\n",
    "\n",
    "chirp_smooth = np.zeros(fft_chirp.shape[0]-10)\n",
    "vrec_smooth = np.zeros(fft_membr.shape[0]-10)\n",
    "zap_smooth = np.zeros(zap.shape[0]-10)\n",
    "\n",
    "for c in range(len(fft_chirp)-10):\n",
    "    chirp_smooth[c] = np.mean(fft_chirp[c:c+10])\n",
    "    vrec_smooth[c] = np.mean(fft_membr[c:c+10])\n",
    "    zap_smooth[c] = np.mean(zap[c:c+10])\n",
    "    \n",
    "ax[0,1].plot(freq[lowf:-10], vrec_smooth[lowf:])\n",
    "# ax[0,1].set_xlim([.2, 40])\n",
    "ax[0,1].set_ylim([0, .4])\n",
    "ax[0,1].grid()\n",
    "ax[0,1].set_title('FFT membrane potential')\n",
    "\n",
    "fft_chirp = 2.0/N * np.abs(fft_chirp[:N//2])\n",
    "ax[1,1].plot(freq[lowf:-10], chirp_smooth[lowf:])\n",
    "ax[1,1].set_title('FFT chirp')\n",
    "#ax[1,1].set_xlim([.2, 40])\n",
    "#ax[1].set_ylim([0, .02])\n",
