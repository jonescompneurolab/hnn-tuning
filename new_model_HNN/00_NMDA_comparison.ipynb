    "def mgblock(v):\n",
    "    mg = 1  # extracellular Mg2+ concentration in mM\n",
    "    return 1 / (1 +  0.28 * np.exp(-0.062 * v) * (mg / 3.57))\n",
    "\n",
    "def mgblock_hoc(v):\n",
    "    return 1.0 / (1.0 + 0.28 * np.exp(-0.062 * v) )\n",
    "\n",
    "v_vals = np.linspace(-100, 50, 300)\n",
    "mg_vals = mgblock(v_vals)\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.plot(v_vals, mg_vals, label='Python function', color='C0')\n",
    "mg_vals_hoc = mgblock_hoc(v_vals)\n",
    "plt.plot(v_vals, mg_vals_hoc, linestyle='--', label='HOC function', color='C1')\n",
    "\n"
   ]
