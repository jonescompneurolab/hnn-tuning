   "source": [
    "celsius = 37.0\n",
    "R = 1\n",
    "cai = 5e-5\n",
    "cao = 2\n",
    "def ghkg(v, cai, cao, z):\n",
    "    f = R*(celsius+273.15)/(z*(1e-3)*h.FARADAY)\n",
    "    xi = v/f\n",
    "    exi = np.exp(xi)\n",
    "    if np.abs(xi) < 1e-4:\n",
    "        fxi = 1 - xi/2\n",
    "    else:\n",
    "        fxi = xi/(exi - 1)\n",
    "    ghkg = f*((cai/cao)*exi - 1)*fxi\n",
    "\n",
    "    return ghkg\n",
    "\n",
    "z = np.linspace(0, 3, 100)\n",
    "\n",
    "v = 0\n",
    "\n",
    "ghkg_values = np.ones_like(z)\n",
    "for i,iz in enumerate(z):\n",
    "    ghkg_values[i] = ghkg(v, cai, cao, iz)\n",
    "plt.figure(figsize=(6,4))\n",
    "plt.plot(z, ghkg_values)"
   ]
  },
