    "# Investigate different Ca dynamics\n",
    "def CaDynamics_E2(ica, cai):\n",
    "    minCai = 5e-5\n",
    "    decay = 122\n",
    "    gamma = 0.0005096\n",
    "    depth = 0.1\n",
    "    cai_strich = -(10000)*(ica*gamma/(2*h.FARADAY*depth)) - (cai - minCai)/decay\n",
    "\n",
    "    return cai+cai_strich\n",
    "\n",
    "def cad(ica, cai):\n",
    "\n",
    "    \n",
    "    depth = 0.1\n",
    "    taur = 100\n",
    "    #cainf = 100e-6\n",
    "    cainf = 5e-5\n",
    "    gamma = 0.0005096\n",
    "    drive_channel =  - (10000) * ica / (2 * h.FARADAY * depth)\n",
    "     \n",
    "    ca_strich = drive_channel/18 + (cainf - cai)/taur*7   \n",
    "    return cai + ca_strich"
   ]
  },
