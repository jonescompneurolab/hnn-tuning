    "def create_comps():\n",
    "    basal = h.Section(name='basal')\n",
    "    basal.L = 255\n",
    "    basal.diam = 8.5\n",
    "    basal.Ra = 100\n",
    "    basal.cm = 1\n",
    "    basal.insert('pas')\n",
    "    \n",
    "    soma = h.Section(name='soma')\n",
    "    soma.L = soma.diam = 12\n",
    "    soma.Ra = 100\n",
    "    soma.cm = 1\n",
    "    soma.insert('hh')\n",
    "\n",
    "    stim = h.IClamp(soma(0.5))\n",
    "    stim.delay = 20\n",
    "    stim.dur = 2    \n",
    "    stim.amp = 0.5\n",
    "\n",
    "    return basal, soma, stim"
   ]
