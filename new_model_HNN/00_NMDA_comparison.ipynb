    "    del basal, soma, syn, nc, stim, t, v_soma, v_basal, nmda_curr\n",
    "    basal, soma, stim, stimb = create_comps_basal_clamp(bamp)\n",
    "    syn = h.Exp2Syn(basal(0.5))\n",
    "    syn.tau1 = 1\n",
    "    syn.tau2 = 10\n",
    "    syn.e = 0\n",
    "\n",
    "    nc = h.NetCon(soma(0.5)._ref_v, syn, sec=soma)\n",
    "    nc.weight[0] = 0.05\n",
    "    nc.delay = 1\n",
    "\n",
    "    t = h.Vector().record(h._ref_t)\n",
    "    v_soma = h.Vector().record(soma(0.5)._ref_v)\n",
    "    v_basal = h.Vector().record(basal(0.5)._ref_v)\n",
    "    nmda_curr = h.Vector().record(syn._ref_i)\n",
    "    h.finitialize(-65)\n",
    "    h.continuerun(500)\n",
    "\n",
    "    ax[0,0].set_title('HNN NMDA (Exp2Syn)')\n",
    "\n",
    "    ax[0,0].plot(t, v_soma, color='tab:blue', alpha=1/(len(bamps)+1-b))\n",
    "    ax[0,0].plot(t, v_basal, color='tab:orange', alpha=1/(len(bamps)+1-b))\n",
    "    ax[0,0].set_ylabel('Membrane potential (mV)')\n",
    "    ax[0,0].set_xlim(0, 30)\n",
    "    ax[0,0].plot(np.linspace(10,21, 100), np.ones(100,)*(-80), color='b', linestyle='--')\n",
    "    t1 = 10\n",
