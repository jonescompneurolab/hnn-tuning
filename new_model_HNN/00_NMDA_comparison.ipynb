    "def create_comps_basal_clamp_ca_dyn_e2(bamp=2, bdur=25):\n",
    "    basal = h.Section(name='basal')\n",
    "    basal.L = 255\n",
    "    basal.diam = 8.5\n",
    "    basal.Ra = 100\n",
    "    basal.cm = 1\n",
    "    basal.insert('pas')\n",
    "    \n",
    "    basal.insert('CaDynamics_E2')\n",
    "    for seg in basal: \n",
    "        seg.CaDynamics_E2.decay = 50\n",
    "        seg.CaDynamics_E2.gamma = .0005096\n",
    "    # basal.insert('Ca_HVA')\n",
    "    # basal.insert('Ca_LVAst')\n",
    "    vcb = h.VClamp(basal(0.5))\n",
    "    vcb.dur[0] = 10\n",
    "    vcb.amp[0] = -80\n",
    "    vcb.dur[1] = bdur\n",
    "    vcb.amp[1] = bamp   \n",
    "    \n",
    "    soma = h.Section(name='soma')\n",
    "    soma.L = soma.diam = 12\n",
    "    soma.Ra = 100\n",
    "    soma.cm = 1\n",
    "    soma.insert('hh')\n",
    "\n",
    "    stim = h.IClamp(soma(0.5))\n",
    "    stim.delay = 20\n",
    "    stim.dur = 2    \n",
    "    stim.amp = 0.5\n",
    "\n",
    "    return basal, soma, stim, vcb"
   ]
  },
