    "    ax[0,1].set_ylabel('NMDA synaptic current (nA)')\n",
    "    ax[0,1].set_xlim(15, 500)\n",
    "\n",
    "    idx = np.where((t.as_numpy() >= 35) & (t.as_numpy() < 100))[0][0]\n",
    "    nmda_grad = np.max(np.abs(np.gradient(nmda_curr.as_numpy()[idx:])))\n",
    "    ax[0,2].plot(RMP, nmda_grad, 'o', color='C3')\n",
    "    ax[0,2].set_xlabel('basal membrane pot. (mV)')\n",
    "    ax[0,2].set_ylabel('NMDA current gradient (nA/ms)')\n",
    "\n",
    "    ax[0,3].plot(t, ca_curr, color='green', alpha=1/(len(bamps)-b))\n",
