    "    syn = h.MyExp2SynNMDABB(basal(0.5))\n",
    "    \n",
    "\n",
    "    nc = h.NetCon(soma(0.5)._ref_v, syn, sec=soma)\n",
    "    nc.weight[0] = 0.05\n",
    "    nc.delay = 1\n",
    "\n",
    "    t = h.Vector().record(h._ref_t)\n",
    "    v_soma = h.Vector().record(soma(0.5)._ref_v)\n",
    "    v_basal = h.Vector().record(basal(0.5)._ref_v)\n",
    "    nmda_curr = h.Vector().record(syn._ref_iNMDA)\n",
    "    ca_curr = h.Vector().record(basal(0.5)._ref_cai)\n",
    "    \n",
    "\n",
    "    h.finitialize(-65)\n",
    "    h.continuerun(500)\n",
    "\n",
    "    ax[0,0].set_title('MyExp2SynNMDABB')\n",
    "\n",
    "    ax[0,0].plot(t, v_soma, color='tab:blue', alpha=1/(len(bamps)-b))\n",
    "    \n",
    "    ax[0,0].plot(t, v_basal, color='tab:orange', alpha=1/(len(bamps)-b))\n",
    "    ax[0,0].set_ylabel('Membrane potential (mV)')\n",
    "    ax[0,0].set_xlim(15, 500)\n",
    "\n",
    "    idx = np.where((t.as_numpy() >= t1) & (t.as_numpy() < t2))[0][0]\n",
    "    idx2 = np.where((t.as_numpy() >= t1) & (t.as_numpy() < t2))[0][-1]\n",
    "    psp = np.max(v_basal.as_numpy()[idx:idx2]) - np.min(v_basal.as_numpy()[idx:idx2])\n",
    "    RMP = np.mean(v_basal.as_numpy()[idx:idx2])\n",
    "    # ax[0,2].plot(RMP, psp, 'o', color='tab:orange')\n",
